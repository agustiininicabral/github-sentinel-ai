    "Fetch Pending Events": {"main": [[{"node": "Split Events", "type": "main", "index": 0}]]},
    "Split Events": {"main": [[{"node": "Normalize Event", "type": "main", "index": 0}]]},
    "Normalize Event": {"main": [[{"node": "Analyze Event", "type": "main", "index": 0}]]},
    "Analyze Event": {"main": [[{"node": "Acknowledge Processed Event", "type": "main", "index": 0}]]}
  },
